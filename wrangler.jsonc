{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pexels-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "pexels.aiautotool.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
